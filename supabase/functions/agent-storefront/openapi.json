{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Storefront API",
    "version": "1.0.0",
    "description": "Authenticated catalog, inventory, quote, order, and webhook API for verified procurement agents.",
    "license": { "name": "Proprietary", "identifier": "LicenseRef-Proprietary" }
  },
  "servers": [
    {
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "api.your-domain.test",
          "description": "Custom domain that maps /v1/agent/* to the Edge Function."
        }
      }
    }
  ],
  "security": [
    {
      "AgentKey": [],
      "AgentSignature": [],
      "AgentTimestamp": [],
      "AgentNonce": []
    }
  ],
  "paths": {
    "/v1/agent/catalog": {
      "get": {
        "summary": "List the principal-scoped product catalog",
        "operationId": "listCatalog",
        "parameters": [
          { "$ref": "#/components/parameters/Category" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/UpdatedSince" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": {
            "description": "Principal-scoped product page",
            "headers": {
              "ETag": { "schema": { "type": "string" } },
              "Last-Modified": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogEnvelope" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/agent/inventory": {
      "get": {
        "summary": "Get current inventory for up to 50 SKUs",
        "operationId": "getInventory",
        "parameters": [
          {
            "name": "skus",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Comma-separated list of 1–50 SKUs."
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": {
            "description": "Inventory source is older than five minutes.",
            "headers": { "Retry-After": { "schema": { "type": "integer" } } }
          }
        }
      }
    },
    "/v1/agent/quotes": {
      "post": {
        "summary": "Create a 15-minute price and availability quote",
        "operationId": "createQuote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items"],
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": ["sku", "qty"],
                      "properties": {
                        "sku": { "type": "string" },
                        "qty": { "type": "integer", "minimum": 1 }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/agent/orders": {
      "post": {
        "summary": "Atomically place an order from an unexpired quote",
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quote_id", "shipping_address"],
                "properties": {
                  "quote_id": { "type": "string", "format": "uuid" },
                  "shipping_address": { "type": "object" },
                  "po_number": { "type": "string", "maxLength": 100 },
                  "requested_ship_date": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/agent/orders/{order_id}": {
      "get": {
        "summary": "Get an order placed by the current credential",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/agent/webhooks": {
      "post": {
        "summary": "Register a signed order-event webhook",
        "operationId": "registerWebhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url", "events"],
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "events": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "order.status_changed",
                        "order.shipped",
                        "order.cancelled"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/agent/openapi.json": {
      "get": {
        "summary": "Get the OpenAPI 3.1 document",
        "security": [],
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AgentKey": { "type": "apiKey", "in": "header", "name": "X-Agent-Key" },
      "AgentSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Agent-Signature"
      },
      "AgentTimestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Agent-Timestamp"
      },
      "AgentNonce": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Agent-Nonce"
      }
    },
    "parameters": {
      "Category": {
        "name": "category",
        "in": "query",
        "schema": { "type": "string" }
      },
      "Search": { "name": "q", "in": "query", "schema": { "type": "string" } },
      "UpdatedSince": {
        "name": "updated_since",
        "in": "query",
        "schema": { "type": "string", "format": "date-time" }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Envelope" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid agent signature",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "RateLimited": {
        "description": "300 requests per minute exceeded",
        "headers": { "Retry-After": { "schema": { "type": "integer" } } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "ValidationError": {
        "description": "Request could not be processed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found in this credential scope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "required": ["request_id", "timestamp"],
        "properties": {
          "request_id": { "type": "string", "format": "uuid" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "Envelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {},
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["data", "error", "meta"],
        "properties": {
          "data": { "type": "null" },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {}
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "CatalogEnvelope": {
        "allOf": [
          { "$ref": "#/components/schemas/Envelope" }
        ]
      }
    }
  }
}
